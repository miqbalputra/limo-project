{
  "name": "limo-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:colors": "node scripts/check-color-tokens.mjs",
    "test": "node --experimental-strip-types tests/run-unit.mjs",
    "test:payment": "node --experimental-strip-types tests/run-payment-gateway.mjs",
    "test:e2e": "node scripts/run-e2e-isolated.mjs",
    "test:e2e:direct": "playwright test",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:pendaftaran-v2": "node --experimental-strip-types tests/run-pendaftaran-v2-integration.mjs",
    "test:quiz-share": "node tests/run-quiz-share-integration.mjs",
    "test:quiz-builder": "node tests/run-quiz-builder-integration.mjs",
    "test:billing-voucher": "node tests/run-billing-voucher-integration.mjs",
    "test:reminders": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types tests/run-reminder-integration.mjs",
    "test:notifications": "node tests/run-notification-log-integration.mjs",
    "test:accounts": "node tests/run-account-management-integration.mjs",
    "test:sertifikat": "node tests/run-certificate-integration.mjs",
    "test:siswa-ujian": "node tests/run-student-exam-integration.mjs",
    "test:diskusi": "node tests/run-class-forum-integration.mjs",
    "test:week1": "node tests/run-week1-integration.mjs",
    "test:week2": "node tests/run-week2-integration.mjs",
    "test:week3": "node tests/run-week3-integration.mjs",
    "test:week4": "node tests/run-week4-integration.mjs",
    "test:week5": "node tests/run-week5-integration.mjs",
    "test:week6": "node tests/run-week6-integration.mjs",
    "test:week7": "node tests/run-week7-integration.mjs",
    "test:week8": "node tests/run-week8-integration.mjs",
    "test:week9": "node tests/run-week9-integration.mjs",
    "test:week10": "node tests/run-week10-integration.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:parity": "node scripts/verify-db-parity.mjs",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "admin:bootstrap": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/bootstrap-admin.ts",
    "seed:production": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/seed-production.ts",
    "sqlite:prepare": "node scripts/prepare-sqlite-schema.mjs",
    "sqlite:setup": "node scripts/setup-sqlite.mjs",
    "billing:generate": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/generate-monthly-invoices.ts",
    "billing:mark-overdue": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/mark-overdue-invoices.ts",
    "sessions:cleanup": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/cleanup-expired-sessions.ts",
    "quiz:finalize": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/finalize-expired-quiz-responses.ts",
    "pengumuman:publish": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/send-due-pengumuman.ts",
    "notifications:retry": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/retry-notifications.ts",
    "reminders:send": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/send-deadline-reminders.ts",
    "reminders:invoices": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/send-invoice-reminders.ts",
    "mayar:reconcile": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/reconcile-mayar-payments.ts",
    "pakasir:reconcile": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/reconcile-pakasir-payments.ts",
    "backup:create": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/backup.ts",
    "backup:restore": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/restore.ts"
  },
  "prisma": {
    "seed": "node --import ./scripts/register-node-module-hooks.mjs --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@types/nodemailer": "^8.0.1",
    "arabic-persian-reshaper": "^1.0.1",
    "argon2": "^0.45.0",
    "bidi-js": "^1.1.0",
    "exceljs": "^4.4.0",
    "next": "^16.0.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
