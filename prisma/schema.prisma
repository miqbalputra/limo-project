generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GURU
  WALI
  SISWA
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProgramKind {
  ENGLISH
  ARABIC
}

enum PendaftaranStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum SiswaStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  ARCHIVED
}

enum SiswaAccountStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum KelasStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum SesiStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum FileVisibility {
  PRIVATE
  INTERNAL
}

enum FileOwnerType {
  PENDAFTARAN
  MATERI
  USER
  SISWA
  RPP
}

enum MateriType {
  TEXT
  PDF
  IMAGE
  VIDEO_LINK
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RppMode {
  FORM
  FILE
}

enum LearningModuleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CalendarEventType {
  CLASS_SESSION
  MODULE_RELEASE
  ASSIGNMENT_DUE
  QUIZ_DUE
  EXAM
  REMEDIAL_DUE
  HOLIDAY
  ANNOUNCEMENT
}

enum CalendarEventVisibility {
  ALL
  GURU
  SISWA
  WALI
}

enum ModuleItemType {
  MATERIAL
  ASSIGNMENT
  QUIZ
  EXAM
  DISCUSSION
  CLASS_SESSION
}

enum AssignmentSubmissionType {
  ONLINE_TEXT
  FILE
  IMAGE
  AUDIO
  VIDEO
  EXTERNAL_LINK
  OFFLINE_ACTIVITY
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  NEEDS_REVISION
  GRADED
}

enum RubricScope {
  PRIVATE
  CLASS
  INSTITUTION
}

enum RubricStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionGradeStatus {
  DRAFT
  PUBLISHED
  REVISED
}

enum GradeCategoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GradeItemSourceType {
  ASSIGNMENT
  QUIZ
  EXAM
  MANUAL
  ATTENDANCE
  PROGRESS
}

enum GradeItemStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum GradeEntryStatus {
  MISSING
  SUBMITTED
  GRADED
  EXEMPT
  REMEDIAL
  FINAL
}

enum FinalGradeStatus {
  DRAFT
  PUBLISHED
  LOCKED
  CORRECTED
}

enum GradeCompletionStatus {
  INCOMPLETE
  COMPLETE
}

enum PresensiStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
  TERLAMBAT
}

enum SoalType {
  PILIHAN_GANDA
  MULTI_SELECT
  BENAR_SALAH
  ISIAN_SINGKAT
  MENJODOHKAN
  URUTAN
  CLOZE
  GAMBAR
  LISTENING
  SPEAKING
  WRITING
  READING
  ROLEPLAY
  ESAI
}

enum HasilUjianStatus {
  DRAFT
  NEEDS_REVIEW
  FINAL
  CORRECTED
}

enum TagihanStatus {
  DRAFT
  UNPAID
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PembayaranStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id                         String                 @id @default(cuid())
  email                      String                 @unique
  name                       String
  passwordHash               String
  role                       UserRole
  status                     UserStatus             @default(ACTIVE)
  lastLoginAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  deletedAt                  DateTime?
  sessions                   Session[]
  resetTokens                PasswordResetToken[]
  guruProfile                GuruProfile?
  waliProfile                WaliProfile?
  siswaAccount               SiswaAccount?
  siswaAccountsActivated     SiswaAccount[]         @relation("SiswaAccountActivator")
  auditLogs                  AuditLog[]             @relation("AuditActor")
  pendaftaranReview          Pendaftaran[]          @relation("PendaftaranReviewer")
  rppCreated                 Rpp[]                  @relation("RppCreator")
  learningModulesCreated     LearningModule[]       @relation("LearningModuleCreator")
  assignmentsCreated         Assignment[]           @relation("AssignmentCreator")
  assignmentSubmissionsActed AssignmentSubmission[] @relation("AssignmentSubmissionActor")
  rubricsOwned               RubricTemplate[]       @relation("RubricOwner")
  submissionGradesGiven      SubmissionGrade[]      @relation("SubmissionGrader")
  gradeCategoriesCreated     GradeCategory[]        @relation("GradeCategoryCreator")
  gradeItemsCreated          GradeItem[]            @relation("GradeItemCreator")
  calendarEventsCreated      CalendarEvent[]        @relation("CalendarEventCreator")
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent   String?   @db.VarChar(255)
  ipAddress   String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, expiresAt])
}

model GuruProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kelas     Kelas[]
}

model WaliProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  address        String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  siswaRelations WaliSiswa[]
  pendaftaran    Pendaftaran[]
  ujianAttempts  UjianAttempt[]
}

model SiswaAccount {
  id              String             @id @default(cuid())
  siswaId         String             @unique
  siswa           Siswa              @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginIdentifier String             @unique
  contactEmail    String?
  status          SiswaAccountStatus @default(PENDING)
  activatedAt     DateTime?
  activatedById   String?
  activatedBy     User?              @relation("SiswaAccountActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  lastLoginAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  reason     String?  @db.Text
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Program {
  id          String        @id @default(cuid())
  name        String        @unique
  kind        ProgramKind
  description String?       @db.Text
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  levels      Level[]
  pendaftaran Pendaftaran[]
  siswa       Siswa[]
  kelas       Kelas[]
  tarif       Tarif[]
}

model Level {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  name        String
  order       Int      @default(0)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kelas       Kelas[]

  @@unique([programId, name])
}

model Pendaftaran {
  id              String                     @id @default(cuid())
  kode            String                     @unique
  status          PendaftaranStatus          @default(DRAFT)
  programId       String
  program         Program                    @relation(fields: [programId], references: [id], onDelete: Restrict)
  studentName     String
  studentBirthAt  DateTime?
  waliName        String
  waliEmail       String
  waliPhone       String?
  waliProfileId   String?
  waliProfile     WaliProfile?               @relation(fields: [waliProfileId], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                      @relation("PendaftaranReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?                    @db.Text
  approvedSiswaId String?                    @unique
  approvedSiswa   Siswa?                     @relation("ApprovedPendaftaran", fields: [approvedSiswaId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  histories       RiwayatStatusPendaftaran[]
  files           FileAsset[]

  @@index([status, createdAt])
  @@index([waliEmail])
}

model RiwayatStatusPendaftaran {
  id            String             @id @default(cuid())
  pendaftaranId String
  pendaftaran   Pendaftaran        @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  fromStatus    PendaftaranStatus?
  toStatus      PendaftaranStatus
  actorId       String?
  reason        String?            @db.Text
  createdAt     DateTime           @default(now())

  @@index([pendaftaranId, createdAt])
}

model Siswa {
  id                    String                 @id @default(cuid())
  nomorInduk            String                 @unique
  name                  String
  birthAt               DateTime?
  status                SiswaStatus            @default(ACTIVE)
  programId             String
  program               Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  siswaAccount          SiswaAccount?
  approvedPendaftaran   Pendaftaran?           @relation("ApprovedPendaftaran")
  waliRelations         WaliSiswa[]
  enrollments           KelasSiswa[]
  presensi              Presensi[]
  progresBelajar        ProgresBelajar[]
  hasilUjian            HasilUjian[]
  assignmentSubmissions AssignmentSubmission[]
  gradeEntries          GradeEntry[]
  finalGrades           FinalGrade[]
  tagihan               Tagihan[]
  ujianAttempts         UjianAttempt[]
}

model WaliSiswa {
  id            String      @id @default(cuid())
  waliProfileId String
  waliProfile   WaliProfile @relation(fields: [waliProfileId], references: [id], onDelete: Cascade)
  siswaId       String
  siswa         Siswa       @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  relationship  String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  endedAt       DateTime?

  @@unique([waliProfileId, siswaId])
  @@index([siswaId])
}

model Kelas {
  id              String           @id @default(cuid())
  name            String
  programId       String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  levelId         String
  level           Level            @relation(fields: [levelId], references: [id], onDelete: Restrict)
  guruProfileId   String?
  guruProfile     GuruProfile?     @relation(fields: [guruProfileId], references: [id], onDelete: SetNull)
  status          KelasStatus      @default(ACTIVE)
  scheduleNote    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  enrollments     KelasSiswa[]
  sessions        SesiKelas[]
  materi          Materi[]
  rpp             Rpp[]
  learningModules LearningModule[]
  assignments     Assignment[]
  gradeCategories GradeCategory[]
  gradeItems      GradeItem[]
  finalGrades     FinalGrade[]
  calendarEvents  CalendarEvent[]
  bankSoal        BankSoal[]
  ujian           Ujian[]
  tarif           Tarif[]

  @@unique([programId, levelId, name])
  @@index([guruProfileId])
}

model KelasSiswa {
  id        String           @id @default(cuid())
  kelasId   String
  kelas     Kelas            @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  siswaId   String
  siswa     Siswa            @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([kelasId, siswaId, startDate])
  @@index([siswaId, status])
  @@index([kelasId, status])
}

model SesiKelas {
  id             String           @id @default(cuid())
  kelasId        String
  kelas          Kelas            @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  meetingNumber  Int
  topic          String
  sessionDate    DateTime
  status         SesiStatus       @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  materi         Materi[]
  presensi       Presensi[]
  progresBelajar ProgresBelajar[]

  @@unique([kelasId, meetingNumber])
  @@index([kelasId, sessionDate])
}

model FileAsset {
  id             String         @id @default(cuid())
  ownerType      FileOwnerType
  ownerId        String
  pendaftaranId  String?
  pendaftaran    Pendaftaran?   @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  materiId       String?
  materi         Materi?        @relation(fields: [materiId], references: [id], onDelete: Cascade)
  rppId          String?
  rpp            Rpp?           @relation(fields: [rppId], references: [id], onDelete: Cascade)
  originalName   String
  storedName     String         @unique
  storagePath    String
  mimeType       String
  sizeBytes      BigInt
  checksumSha256 String?
  visibility     FileVisibility @default(PRIVATE)
  uploadedById   String?
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  @@index([ownerType, ownerId])
  @@index([pendaftaranId])
  @@index([materiId])
  @@index([rppId])
}

model Materi {
  id          String        @id @default(cuid())
  kelasId     String
  kelas       Kelas         @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  sesiKelasId String?
  sesiKelas   SesiKelas?    @relation(fields: [sesiKelasId], references: [id], onDelete: SetNull)
  type        MateriType
  status      PublishStatus @default(DRAFT)
  title       String
  content     String?       @db.Text
  videoUrl    String?
  language    String?       @db.VarChar(16)
  direction   String?       @db.VarChar(8)
  order       Int           @default(0)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       FileAsset[]

  @@index([kelasId, status])
  @@index([sesiKelasId])
}

model Rpp {
  id                 String        @id @default(cuid())
  kelasId            String
  kelas              Kelas         @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User          @relation("RppCreator", fields: [createdById], references: [id], onDelete: Restrict)
  mode               RppMode
  status             PublishStatus @default(DRAFT)
  title              String
  planDate           DateTime
  meetingNumber      Int?
  topic              String
  learningObjectives String        @db.Text
  materials          String        @db.Text
  difficulty         String        @db.VarChar(32)
  activities         String        @db.Text
  assessment         String        @db.Text
  durationMinutes    Int?
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  files              FileAsset[]

  @@index([kelasId, status, planDate])
  @@index([createdById, createdAt])
}

model LearningModule {
  id          String               @id @default(cuid())
  kelasId     String
  kelas       Kelas                @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  title       String
  description String?              @db.Text
  order       Int                  @default(0)
  status      LearningModuleStatus @default(DRAFT)
  releaseAt   DateTime?
  dueAt       DateTime?
  createdById String
  createdBy   User                 @relation("LearningModuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       ModuleItem[]

  @@index([kelasId, status, order])
  @@index([createdById, createdAt])
}

model CalendarEvent {
  id          String                  @id @default(cuid())
  classId     String?
  kelas       Kelas?                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?                 @db.Text
  eventType   CalendarEventType
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean                 @default(false)
  visibility  CalendarEventVisibility @default(ALL)
  createdById String?
  createdBy   User?                   @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([classId, startAt, eventType])
  @@index([visibility, startAt])
  @@index([createdById, createdAt])
}

model ModuleItem {
  id                 String         @id @default(cuid())
  moduleId           String
  module             LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  itemType           ModuleItemType
  entityId           String
  titleOverride      String?
  order              Int            @default(0)
  isRequired         Boolean        @default(true)
  availableFrom      DateTime?
  availableUntil     DateTime?
  prerequisiteItemId String?
  prerequisiteItem   ModuleItem?    @relation("ModuleItemPrerequisite", fields: [prerequisiteItemId], references: [id], onDelete: SetNull)
  dependentItems     ModuleItem[]   @relation("ModuleItemPrerequisite")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([moduleId, itemType, entityId])
  @@index([moduleId, order])
  @@index([prerequisiteItemId])
}

model Assignment {
  id                  String                   @id @default(cuid())
  kelasId             String
  kelas               Kelas                    @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  title               String
  instructions        String                   @db.Text
  submissionType      AssignmentSubmissionType
  maxScore            Int                      @default(100)
  availableFrom       DateTime?
  dueAt               DateTime?
  cutoffAt            DateTime?
  maxAttempts         Int                      @default(1)
  allowLateSubmission Boolean                  @default(false)
  allowResubmission   Boolean                  @default(false)
  status              PublishStatus            @default(DRAFT)
  createdById         String
  createdBy           User                     @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rubricTemplateId    String?
  rubricTemplate      RubricTemplate?          @relation("AssignmentRubric", fields: [rubricTemplateId], references: [id], onDelete: SetNull)
  rubricSnapshot      Json?
  publishedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  submissions         AssignmentSubmission[]

  @@index([kelasId, status, availableFrom])
  @@index([createdById, createdAt])
}

model AssignmentSubmission {
  id            String                     @id @default(cuid())
  assignmentId  String
  assignment    Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Siswa                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attemptNumber Int
  status        AssignmentSubmissionStatus @default(DRAFT)
  onlineText    String?                    @db.Text
  externalLink  String?                    @db.Text
  submittedAt   DateTime?
  isLate        Boolean                    @default(false)
  actorUserId   String?
  actorUser     User?                      @relation("AssignmentSubmissionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  version       Int                        @default(0)
  draftSavedAt  DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  files         AssignmentSubmissionFile[]
  grades        SubmissionGrade[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, status])
  @@index([studentId, assignmentId, createdAt])
}

model AssignmentSubmissionFile {
  id            String               @id @default(cuid())
  submissionId  String
  submission    AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storageKey    String               @unique
  storagePath   String
  originalName  String
  mimeType      String
  sizeBytes     BigInt
  checksum      String?
  mediaDuration Int?
  createdAt     DateTime             @default(now())

  @@index([submissionId, createdAt])
}

model RubricTemplate {
  id          String            @id @default(cuid())
  ownerUserId String
  owner       User              @relation("RubricOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  title       String
  description String?           @db.Text
  scope       RubricScope       @default(PRIVATE)
  status      RubricStatus      @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  criteria    RubricCriterion[]
  assignments Assignment[]      @relation("AssignmentRubric")

  @@index([ownerUserId, status, createdAt])
}

model RubricCriterion {
  id              String           @id @default(cuid())
  rubricId        String
  rubric          RubricTemplate   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name            String
  description     String?          @db.Text
  maxScore        Int
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  levels          RubricLevel[]
  criterionGrades CriterionGrade[]

  @@index([rubricId, order])
}

model RubricLevel {
  id              String           @id @default(cuid())
  criterionId     String
  criterion       RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  label           String
  description     String?          @db.Text
  score           Int
  order           Int              @default(0)
  criterionGrades CriterionGrade[]

  @@index([criterionId, order])
}

model SubmissionGrade {
  id                      String                @id @default(cuid())
  submissionId            String
  submission              AssignmentSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  graderUserId            String
  grader                  User                  @relation("SubmissionGrader", fields: [graderUserId], references: [id], onDelete: Restrict)
  rawScore                Int?
  score                   Int?
  feedbackText            String?               @db.Text
  feedbackAudioStorageKey String?
  status                  SubmissionGradeStatus @default(DRAFT)
  correctionReason        String?               @db.Text
  publishedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  criteria                CriterionGrade[]

  @@index([submissionId, status, createdAt])
  @@index([graderUserId, createdAt])
}

model CriterionGrade {
  id                String          @id @default(cuid())
  submissionGradeId String
  submissionGrade   SubmissionGrade @relation(fields: [submissionGradeId], references: [id], onDelete: Cascade)
  criterionId       String
  criterion         RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  rubricLevelId     String?
  rubricLevel       RubricLevel?    @relation(fields: [rubricLevelId], references: [id], onDelete: SetNull)
  score             Int
  comment           String?         @db.Text

  @@unique([submissionGradeId, criterionId])
  @@index([criterionId])
}

model GradeCategory {
  id              String              @id @default(cuid())
  classId         String
  kelas           Kelas               @relation(fields: [classId], references: [id], onDelete: Cascade)
  name            String
  weight          Decimal             @db.Decimal(6, 2)
  order           Int                 @default(0)
  dropLowestCount Int                 @default(0)
  status          GradeCategoryStatus @default(DRAFT)
  createdById     String?
  createdBy       User?               @relation("GradeCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           GradeItem[]

  @@index([classId, status, order])
  @@index([createdById, createdAt])
}

model GradeItem {
  id             String              @id @default(cuid())
  classId        String
  kelas          Kelas               @relation(fields: [classId], references: [id], onDelete: Cascade)
  categoryId     String
  category       GradeCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceType     GradeItemSourceType
  sourceId       String?
  title          String
  order          Int                 @default(0)
  maxScore       Decimal             @db.Decimal(10, 2)
  weightOverride Decimal?            @db.Decimal(6, 2)
  isExtraCredit  Boolean             @default(false)
  status         GradeItemStatus     @default(DRAFT)
  dueAt          DateTime?
  createdById    String?
  createdBy      User?               @relation("GradeItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  entries        GradeEntry[]

  @@unique([classId, sourceType, sourceId])
  @@index([classId, status, dueAt])
  @@index([categoryId, order])
  @@index([sourceType, sourceId])
}

model GradeEntry {
  id              String           @id @default(cuid())
  gradeItemId     String
  gradeItem       GradeItem        @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentId       String
  student         Siswa            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rawScore        Decimal?         @db.Decimal(10, 2)
  normalizedScore Decimal?         @db.Decimal(7, 2)
  status          GradeEntryStatus @default(MISSING)
  isLate          Boolean          @default(false)
  feedbackSummary String?          @db.Text
  sourceVersion   String?          @db.VarChar(191)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([gradeItemId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([gradeItemId, status])
}

model FinalGrade {
  id               String                @id @default(cuid())
  classId          String
  kelas            Kelas                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId        String
  student          Siswa                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  calculatedScore  Decimal?              @db.Decimal(7, 2)
  publishedScore   Decimal?              @db.Decimal(7, 2)
  letterGrade      String?               @db.VarChar(8)
  completionStatus GradeCompletionStatus @default(INCOMPLETE)
  status           FinalGradeStatus      @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([classId, studentId])
  @@index([classId, status, updatedAt])
  @@index([studentId, status, updatedAt])
}

model Presensi {
  id          String         @id @default(cuid())
  sesiKelasId String
  sesiKelas   SesiKelas      @relation(fields: [sesiKelasId], references: [id], onDelete: Cascade)
  siswaId     String
  siswa       Siswa          @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  status      PresensiStatus
  note        String?        @db.Text
  finalizedAt DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([siswaId, sesiKelasId])
  @@index([sesiKelasId, status])
}

model ProgresBelajar {
  id                 String    @id @default(cuid())
  sesiKelasId        String
  sesiKelas          SesiKelas @relation(fields: [sesiKelasId], references: [id], onDelete: Cascade)
  siswaId            String
  siswa              Siswa     @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  category           String?   @db.VarChar(64)
  understandingScore Int
  publicNote         String?   @db.Text
  internalNote       String?   @db.Text
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([siswaId, sesiKelasId, category])
  @@index([sesiKelasId])
}

model BankSoal {
  id                String         @id @default(cuid())
  kelasId           String?
  kelas             Kelas?         @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  type              SoalType
  question          String         @db.Text
  stimulusText      String?        @db.Text
  mediaUrl          String?        @db.VarChar(500)
  expectedAnswer    String?        @db.Text
  structuredPayload Json?
  rubric            Json?
  language          String?        @db.VarChar(16)
  direction         String?        @db.VarChar(8)
  cognitiveLevel    String         @default("LOTS") @db.VarChar(16)
  skill             String         @default("VOCABULARY") @db.VarChar(32)
  difficulty        String         @default("EASY") @db.VarChar(16)
  standard          String?        @db.VarChar(64)
  assessmentType    String         @default("FORMATIVE") @db.VarChar(24)
  explanation       String?        @db.Text
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  options           OpsiSoal[]
  ujianSoal         UjianSoal[]
  answers           JawabanUjian[]

  @@index([kelasId, type])
}

model OpsiSoal {
  id         String   @id @default(cuid())
  bankSoalId String
  bankSoal   BankSoal @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)
  label      String   @db.VarChar(8)
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@unique([bankSoalId, label])
}

model Ujian {
  id               String         @id @default(cuid())
  kelasId          String
  kelas            Kelas          @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  title            String
  description      String?        @db.Text
  status           PublishStatus  @default(DRAFT)
  examDate         DateTime?
  durationMinutes  Int            @default(60)
  deliveryMode     String         @default("TEACHER_ENTRY") @db.VarChar(32)
  availableFrom    DateTime?
  availableUntil   DateTime?
  maxAttempts      Int            @default(1)
  showResultToWali Boolean        @default(true)
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  questions        UjianSoal[]
  results          HasilUjian[]
  attempts         UjianAttempt[]

  @@index([kelasId, status])
}

model UjianAttempt {
  id            String      @id @default(cuid())
  ujianId       String
  ujian         Ujian       @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  siswaId       String
  siswa         Siswa       @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  waliProfileId String
  waliProfile   WaliProfile @relation(fields: [waliProfileId], references: [id], onDelete: Restrict)
  hasilUjianId  String?
  status        String      @default("IN_PROGRESS") @db.VarChar(32)
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  expiresAt     DateTime?
  draftAnswers  Json?
  draftSavedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([ujianId, siswaId])
  @@index([waliProfileId, status])
}

model UjianSoal {
  id         String         @id @default(cuid())
  ujianId    String
  ujian      Ujian          @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  bankSoalId String
  bankSoal   BankSoal       @relation(fields: [bankSoalId], references: [id], onDelete: Restrict)
  order      Int            @default(0)
  weight     Decimal        @db.Decimal(10, 2)
  answers    JawabanUjian[]

  @@unique([ujianId, bankSoalId])
  @@index([bankSoalId])
}

model HasilUjian {
  id          String           @id @default(cuid())
  ujianId     String
  ujian       Ujian            @relation(fields: [ujianId], references: [id], onDelete: Restrict)
  siswaId     String
  siswa       Siswa            @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  status      HasilUjianStatus @default(DRAFT)
  totalScore  Decimal?         @db.Decimal(10, 2)
  finalizedAt DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  answers     JawabanUjian[]

  @@unique([ujianId, siswaId])
  @@index([siswaId, status])
}

model JawabanUjian {
  id               String     @id @default(cuid())
  hasilUjianId     String
  hasilUjian       HasilUjian @relation(fields: [hasilUjianId], references: [id], onDelete: Cascade)
  ujianSoalId      String
  ujianSoal        UjianSoal  @relation(fields: [ujianSoalId], references: [id], onDelete: Restrict)
  bankSoalId       String
  bankSoal         BankSoal   @relation(fields: [bankSoalId], references: [id], onDelete: Restrict)
  selectedOption   String?    @db.VarChar(8)
  selectedOptions  Json?
  shortAnswer      String?    @db.Text
  structuredAnswer Json?
  essayAnswer      String?    @db.Text
  score            Decimal?   @db.Decimal(10, 2)
  needsReview      Boolean    @default(false)
  reviewedById     String?
  reviewedAt       DateTime?

  @@unique([hasilUjianId, ujianSoalId])
  @@index([bankSoalId])
}

model Tarif {
  id            String    @id @default(cuid())
  name          String
  programId     String?
  program       Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)
  kelasId       String?
  kelas         Kelas?    @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  amount        Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tagihan       Tagihan[]

  @@index([programId, effectiveFrom])
  @@index([kelasId, effectiveFrom])
}

model Tagihan {
  id          String        @id @default(cuid())
  siswaId     String
  siswa       Siswa         @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  tarifId     String?
  tarif       Tarif?        @relation(fields: [tarifId], references: [id], onDelete: SetNull)
  periode     DateTime
  jenis       String        @db.VarChar(64)
  description String?
  amount      Decimal       @db.Decimal(14, 2)
  status      TagihanStatus @default(DRAFT)
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pembayaran  Pembayaran[]

  @@unique([siswaId, periode, jenis])
  @@index([status, dueDate])
}

model Pembayaran {
  id                String           @id @default(cuid())
  tagihanId         String
  tagihan           Tagihan          @relation(fields: [tagihanId], references: [id], onDelete: Restrict)
  provider          String
  providerReference String           @unique
  amount            Decimal          @db.Decimal(14, 2)
  status            PembayaranStatus
  paymentMethod     String?
  paidAt            DateTime?
  rawPayload        Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tagihanId, status])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payloadHash     String    @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, createdAt])
}

model Notifikasi {
  id         String                 @id @default(cuid())
  channel    String
  template   String
  recipient  String
  subject    String?
  body       String                 @db.Text
  status     NotificationStatus     @default(PENDING)
  metadata   Json?
  dedupeKey  String?                @unique
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id             String             @id @default(cuid())
  notificationId String
  notification   Notifikasi         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  provider       String
  status         NotificationStatus @default(PENDING)
  attempt        Int                @default(0)
  response       Json?
  errorMessage   String?            @db.Text
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([notificationId, status])
}

model JobRun {
  id           String    @id @default(cuid())
  name         String
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  successCount Int       @default(0)
  skippedCount Int       @default(0)
  failedCount  Int       @default(0)
  metadata     Json?
  errorMessage String?   @db.Text

  @@index([name, startedAt])
}
