{
  "name": "LIMO Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "limo-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5f1a1c20-0001-4a01-9a01-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "limo-email"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.headers[\"x-limo-webhook-secret\"] }}",
              "operation": "equal",
              "value2": "GANTI_DENGAN_N8N_WEBHOOK_SECRET"
            }
          ]
        }
      },
      "id": "5f1a1c20-0002-4a02-9a02-000000000002",
      "name": "Secret Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.recipient }}",
        "subject": "={{ $json.body.subject || \"Notifikasi LIMO\" }}",
        "emailType": "text",
        "message": "={{ $json.body.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "5f1a1c20-0003-4a03-9a03-000000000003",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        460,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "chatId": "GANTI_CHAT_ID_TELEGRAM",
        "text": "=✅ LIMO email terkirim\nKepada: {{ $json.body.recipient }}\nSubjek: {{ $json.body.subject }}\nTemplate: {{ $json.body.metadata?.template || '-' }}\nNotif ID: {{ $json.body.notificationId }}"
      },
      "id": "5f1a1c20-0006-4a06-9a06-000000000006",
      "name": "Telegram Sukses",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "chatId": "GANTI_CHAT_ID_TELEGRAM",
        "text": "=❌ LIMO email GAGAL terkirim\nKepada: {{ $json.body.recipient }}\nSubjek: {{ $json.body.subject }}\nTemplate: {{ $json.body.metadata?.template || '-' }}\nNotif ID: {{ $json.body.notificationId }}\nError: {{ $json.error?.message || $json.error?.description || 'tidak diketahui' }}"
      },
      "id": "5f1a1c20-0007-4a07-9a07-000000000007",
      "name": "Telegram Gagal",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "5f1a1c20-0004-4a04-9a04-000000000004",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        960,
        -160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'email gagal dikirim' } }}",
        "options": {
          "responseCode": 500
        }
      },
