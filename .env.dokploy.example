APP_URL=https://limo-demo.example.com
SESSION_SECRET=replace-with-random-secret-minimum-32-chars

MARIADB_ROOT_PASSWORD=replace-with-random-root-password
MARIADB_DATABASE=limo_db
MARIADB_USER=limo
MARIADB_PASSWORD=replace-with-random-db-password

SESSION_COOKIE_NAME=limo_session
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=10080
MAX_REGISTRATION_FILE_MB=10
MAX_MATERIAL_FILE_MB=25
MAX_RPP_FILE_MB=20
MAX_ASSIGNMENT_FILE_MB=25
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
BACKUP_WEBHOOK_SECRET=replace-with-random-backup-secret-minimum-32-chars
NOTIFICATION_PROVIDER=n8n
STUDENT_PORTAL_ENABLED=false
LEARNING_MODULES_ENABLED=false
ASSIGNMENTS_ENABLED=false
GRADEBOOK_ENABLED=false
CLASS_DISCUSSION_ENABLED=false
PERIODIC_REPORTS_ENABLED=false
GUARDIAN_ASSISTED_SUBMISSION_ENABLED=false
NEXT_PUBLIC_LIMO_CONTACT_EMAIL=

MAYAR_ENV=production
MAYAR_BASE_URL=
MAYAR_API_KEY=
MAYAR_MERCHANT_ID=
MAYAR_WEBHOOK_SECRET=
N8N_EMAIL_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Set true only once on an empty demo database if you need seeded demo accounts.
DOKPLOY_SEED_ON_START=false

# Demo-only escape hatch when an interrupted migration blocks startup.
DOKPLOY_DB_PUSH_ON_START=false

# Fast disposable demo mode: use SQLite instead of MariaDB.
DOKPLOY_SQLITE_DEMO=false
SQLITE_DATABASE_URL=file:/app/data/limo-demo.db
